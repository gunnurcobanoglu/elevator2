        private void AddStatusMessage(string message)
        {
            var timestamp = DateTime.Now.ToString("HH:mm:ss");
            var newMessage = $"[{timestamp}] {message}";
            
            if (string.IsNullOrEmpty(_statusMessage))
            {
                StatusMessage = newMessage;
            }
            else
            {
                // Yeni mesajı EN ÜSTE ekle
                StatusMessage = newMessage + "\n" + _statusMessage;
            }
        }

        private bool CanCallElevator(object? parameter)
        {
            // Sol panelden her zaman çağrılabilir
            return parameter is int;
        }

        private async void OnCallElevator(object? parameter)
        {
            if (parameter is int callingFloor)
            {
                if (!_isSimulationRunning)
                {
                    _simulationStartTime = DateTime.Now;
                    _timer.Start();
                    _isSimulationRunning = true;
                }

                // Hangi asansörün daha yakın olduğunu belirle
                int distance1 = Math.Abs(_currentFloor - callingFloor);
                int distance2 = Math.Abs(_currentFloor2 - callingFloor);

                // Her iki asansörün de meşgul olup olmadığını kontrol et
                bool elevator1Busy = _isProcessingRequests || _elevator.State != Models.ElevatorState.Idle;
                bool elevator2Busy = _isProcessingRequests2 || _elevator2.State != Models.ElevatorState.Idle;

                // Asansör seçim mantığı
                bool useElevator1 = true;
                if (elevator1Busy && !elevator2Busy)
                {
                    useElevator1 = false;
                }
                else if (!elevator1Busy && elevator2Busy)
                {
                    useElevator1 = true;
                }
                else
                {
                    // Her ikisi de boş veya meşgul ise yakınlığa göre seç
                    useElevator1 = distance1 <= distance2;
                }

                if (useElevator1)
                {
                    var request = new PassengerRequest(callingFloor);
                    request.SimulationTime = CurrentSimulationTime;
                    request.ElevatorFloorAtRequest = _currentFloor;
                    request.RequestTime = DateTime.Now;

                    _pendingRequests.Add(request);

                    AddStatusMessage($"[{CurrentSimulationTime:hh\\:mm}] [Asansör 1] Kat {callingFloor}: Çağrı geldi");

                    // Kat mesafesini hesapla
                    int floorDistance = Math.Abs(callingFloor - _currentFloor);

                    _mlDataCollector.RecordRequest(
                        CurrentSimulationTime,
                        callingFloor,
                        _currentFloor,
                        -1,                          // Hedef kat henüz bilinmiyor
                        floorDistance,               // Kat mesafesi
                        "Asansör 1",                // Seçilen asansör
                        0,                           // Bekleme süresi henüz 0
                        _passengerCount,
                        _elevator.State.ToString()
                    );

                    if (callingFloor == _currentFloor && _elevator.State == Models.ElevatorState.Idle)
                    {
                        await HandleSameFloorPickup(request);
                    }
                    else if (!_isProcessingRequests)
                    {
                        await ProcessRequests();
                    }
                }
                else
                {
                    var request = new PassengerRequest(callingFloor);
                    request.SimulationTime = CurrentSimulationTime;
                    request.ElevatorFloorAtRequest = _currentFloor2;
                    request.RequestTime = DateTime.Now;

                    _pendingRequests2.Add(request);

                    AddStatusMessage($"[{CurrentSimulationTime:hh\\:mm}] [Asansör 2] Kat {callingFloor}: Çağrı geldi");

                    // Kat mesafesini hesapla
                    int floorDistance = Math.Abs(callingFloor - _currentFloor2);

                    _mlDataCollector.RecordRequest(
                        CurrentSimulationTime,
                        callingFloor,
                        _currentFloor2,
                        -1,                          // Hedef kat henüz bilinmiyor
                        floorDistance,               // Kat mesafesi
                        "Asansör 2",                // Seçilen asansör
                        0,                           // Bekleme süresi henüz 0
                        _passengerCount2,
                        _elevator2.State.ToString()
                    );

                    if (callingFloor == _currentFloor2 && _elevator2.State == Models.ElevatorState.Idle)
                    {
                        await HandleSameFloorPickup2(request);
                    }
                    else if (!_isProcessingRequests2)
                    {
                        await ProcessRequests2();
                    }
                }
            }
        }

        private bool CanSelectDestination(object? parameter)
        {
            // İç panel sadece yolcu varken aktif
            return parameter is int targetFloor && 
                   _isInnerPanelOpen && 
                   targetFloor != _currentFloor &&
                   _passengerCount > 0;
        }

        private bool CanSelectDestination2(object? parameter)
        {
